# Copie este arquivo para `.env.local` e preencha.
# O `.env.local` NUNCA vai para o Git (esta no .gitignore).

# Token da Apify para coletar comentarios do Instagram.
# Crie em: https://console.apify.com/account/integrations
# Se deixar vazio, voce pode colar o token pelo botao CONFIGURAR API no painel
# (fica so no sessionStorage da aba, nao e salvo no disco).
APIFY_TOKEN=

# Porta do painel local.
PORT=3214

# Interface de escuta. Mantenha 127.0.0.1 para nao expor na rede.
# Para expor, defina PANEL_PASSWORD e sirva por HTTPS atras de proxy.
HOST=127.0.0.1

# Senha obrigatoria se HOST for diferente de 127.0.0.1.
PANEL_PASSWORD=

# URL publica do logo da sua marca (opcional).
# Se vazio, o painel usa um SVG neutro em public/assets/logo-fallback.svg
MARCA_LOGO_URL=

# Nome da marca exibido no rodape da arte gerada (opcional).
MARCA_NOME=
